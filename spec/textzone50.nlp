###############################################
# FILE: textzone50.pat
# SUBJ: Specialized text zones.
# AUTH: AM
# CREATED: 07/Jul/04 23:34:51
# MODIFIED:
###############################################

@CODE
if (!G("num lines"))
  exitpass();
@@CODE

@NODES _ROOT

# Stop at the first line of a new paragraph. A line like "1. Discretion..."
# inside running prose made a zone that took every line to the end of the
# book (War and Peace: 71% of it).
@PRE
<2,2> varz("PAR");
@POST
  merge();
@RULES
_TEXTZONE <-
	_TEXTZONE
	_xWILD [star match=(_LINE)]
	@@

	