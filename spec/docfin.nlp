###############################################
# FILE: docfin.nlp
# SUBJ: Finish the outputs that the per-zone passes write.
# AUTH: David de Hilster
# CREATED: 2026-10-27
# NOTE:	Runs once, after the last text zone (it follows the endzone line
#		in analyzer.seq). pos_out_noscore and xmlrecursive run once per
#		zone, so their end-of-document work moved here.
###############################################

@CODE

# The part-of-speech lists that pos_out_noscore gathered in the KB.
if (G("verbose") && !G("pretagged"))
  postofile();

# The embedded-tag XML that xmlrecursive opened in the first zone.
if (G("xml recursive") && G("oxml"))
  {
  xmlend("doc",G("oxml"));
  closefile(G("oxml"));
  }

@@CODE
